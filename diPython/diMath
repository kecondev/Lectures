    """

    #소수찾기
    def diIsPrime(self, num):
        #num이 소수인지 판별하여 반환한다.
        if not isinstance(num, int) or isinstance(num, bool):
            raise TypeError("정수만 허용됩니다.")
        if num < 2:
            return False
        if num % 2 == 0:
            return num == 2

        for i in range(3, math.isqrt(num) + 1, 2):
            if num % i == 0:
                return False
        return True
    """ 예제
    print(diIsPrime(7))
    """

    #소인수 찾기
    def diPrimeFactor(self, number):
        """정수를 소인수분해하여 소인수 목록을 반환합니다."""
        if number < 2 or not isinstance(number, int):
            raise ValueError("2 이상의 정수를 입력해주세요.")

        factors = []
        divisor = 2

        while divisor * divisor <= number:
            while number % divisor == 0:
                factors.append(divisor)
                number //= divisor
            divisor += 1

        if number > 1:
            factors.append(number)

        return factors
    """ 예제
    print(diPrimeFactor(60))  # 예제: 60의 소인수분해 결과 출력
        --> [2, 2, 3, 5]
    """

    #약수 구하기
    def diDivisors(self, n):
        """1 이상의 정수가 가진 모든 약수를 오름차순으로 반환합니다."""
        if isinstance(n, bool) or not isinstance(n, int) or n < 1:
            raise ValueError("1 이상의 정수를 입력해주세요.")

        small = []
        large = []

        for divisor in range(1, math.isqrt(n) + 1):
            if n % divisor == 0:
                small.append(divisor)

                paired_divisor = n // divisor
                if divisor != paired_divisor:
                    large.append(paired_divisor)

        return small + large[::-1]
    """ 예제
    print(diDivisors(60))  # 예제: 60의 약수 구하기
    """
    
    def diGCD(a, b):
        """두 정수의 최대공약수를 반환합니다."""
        if not isinstance(a, int) or not isinstance(b, int):
            raise TypeError("정수를 입력해주세요.")

        a, b = abs(a), abs(b)

        while b != 0:
            a, b = b, a % b

        return a
