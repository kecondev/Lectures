    #홀수/짝수 판별 방법
    def diOdd_Even(self, num):
        #num이 홀수인지 짝수인지 판별하여 반환한다.
        if not isinstance(num, int):
            raise TypeError("정수만 허용됩니다.")
        return "홀수" if num % 2 != 0 else "짝수"
    """ 예제
